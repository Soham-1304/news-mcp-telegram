# =============================================================================
# News MCP Server & Telegram AI Agent - Environment Configuration
# =============================================================================

# Decoupled MCP Server URL
MCP_SERVER_URL=http://127.0.0.1:8001/sse

# LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_MODEL=openai/gpt-oss-120b

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=

# Schedule Configuration
SCHEDULE_TIME=07:00
SCHEDULE_TIMEZONE=Asia/Kolkata

# Local Database Storage Paths
NEWS_DB_PATH=data/news_history.db
MEMORY_DB_PATH=data/agent_memory.db

# Deduplication & Freshness Settings
MAX_ARTICLE_AGE_HOURS=168
FUZZY_MATCH_THRESHOLD=85
